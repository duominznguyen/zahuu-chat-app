# URL tới backend NestJS. Dùng EXPO_PUBLIC_ prefix để Expo inline vào bundle client.
# - Android emulator: dùng http://10.0.2.2:3001 (alias trỏ về localhost máy host)
# - iOS simulator: dùng http://localhost:3001 (simulator share network với máy host)
# - Thiết bị thật (cùng Wi-Fi với máy chạy backend): dùng LAN IP của máy, ví dụ http://192.168.1.10:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_SOCKET_URL=http://localhost:3001
