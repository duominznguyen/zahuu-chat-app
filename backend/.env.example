PORT=3001
DATABASE_URL="mysql://root:root123@localhost:3306/zahuu_chat?allowPublicKeyRetrieval=true"
REDIS_HOST=localhost
REDIS_PORT=6379

# Web-frontend origin(s) được phép gửi cookie cross-origin (credentials: true không
# cho phép dùng wildcard '*'), phân tách bởi dấu phẩy nếu có nhiều origin.
CORS_ORIGINS=http://localhost:5173

JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASS=change-me
MAIL_FROM="Zahuu Chat <your-address@gmail.com>"

GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com

USERNAME_CHANGE_COOLDOWN_DAYS=14

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=change-me
CLOUDINARY_FOLDER=zahuu/dev
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=50
MEDIA_MAX_FILE_MB=10


FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nchange-me\n-----END PRIVATE KEY-----\n"

# LiveKit Cloud (gọi điện). Lấy từ LiveKit Cloud dashboard → project → Settings → Keys.
# LIVEKIT_URL dạng wss://<project>.livekit.cloud. Không có các biến này thì endpoint gọi điện trả 503.
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_URL=wss://your-project.livekit.cloud
