// ============================================================
// Zalo-like Chat App — Prisma Schema (MySQL)
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ------------------------------------------------------------
// 1. USER
// ------------------------------------------------------------

model User {
  id                String    @id @default(uuid())
  username          String    @unique // @handle, e.g. duominznguyen
  usernameChangedAt DateTime? // to enforce cooldown before next change
  email             String?   @unique // always verified when present (OTP or Google). Nullable so future providers without email (GitHub private email, phone) still work
  passwordHash      String? // null if account only has OAuth providers (e.g. Google-only)
  displayName       String
  avatarUrl         String?
  coverUrl          String?
  bio               String?   @db.VarChar(255)
  birthday          DateTime?
  gender            Gender?
  lastSeenAt        DateTime? // periodically updated; live online status lives in Redis
  deactivatedAt     DateTime? // soft-delete / disable account
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  authProviders AuthProvider[]
  refreshTokens RefreshToken[]
  deviceTokens  DeviceToken[]

  sentFriendRequests     FriendRequest[] @relation("SentRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedRequests")
  friendshipsAsUser1     Friendship[]    @relation("FriendshipUser1")
  friendshipsAsUser2     Friendship[]    @relation("FriendshipUser2")

  blocksInitiated Block[] @relation("BlockedBy")
  blocksReceived  Block[] @relation("BlockedUser")

  conversationsAsUser1 Conversation[]         @relation("DirectUser1")
  conversationsAsUser2 Conversation[]         @relation("DirectUser2")
  memberships          ConversationMember[]
  nicknamesSet         ConversationNickname[] @relation("NicknameSetBy")

  messagesSent     Message[]
  messageReactions MessageReaction[]
  messageDeletions MessageDeletion[]

  callsStarted       Call[]
  callParticipations CallParticipant[]

  createdInviteLinks GroupInviteLink[]

  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsActedOn  Notification[] @relation("NotificationActor")

  @@index([displayName])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ------------------------------------------------------------
// AUTH
// ------------------------------------------------------------

model AuthProvider {
  id                String           @id @default(uuid())
  userId            String
  provider          AuthProviderType
  providerAccountId String // e.g. Google's `sub` claim
  createdAt         DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum AuthProviderType {
  LOCAL
  GOOGLE
  // FACEBOOK, APPLE, ... add later without touching User table
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique // never store plaintext
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String? // id of the token that rotated this one out, for reuse-detection
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DeviceToken {
  id        String         @id @default(uuid())
  userId    String
  fcmToken  String         @unique
  platform  DevicePlatform
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

// In-app notification center — riêng biệt với việc gửi FCM push (đẩy qua BullMQ).
// Gắn trực tiếp vào các event nghiệp vụ đã emit sẵn (friend.*, group.member.added),
// không phải nguồn sự kiện riêng.
model Notification {
  id             String           @id @default(uuid())
  userId         String // người nhận
  type           NotificationType
  actorId        String? // người gây ra hành động, null nếu hệ thống tự động
  conversationId String? // chỉ có với GROUP_MEMBER_ADDED
  isRead         Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  user         User          @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor        User?         @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt]) // cursor-based pagination + đếm chưa đọc
}

enum NotificationType {
  FRIEND_REQUEST_RECEIVED
  FRIEND_REQUEST_ACCEPTED
  GROUP_MEMBER_ADDED
}

// ------------------------------------------------------------
// 2. FRIEND
// ------------------------------------------------------------

model FriendRequest {
  id          String              @id @default(uuid())
  senderId    String
  receiverId  String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?

  sender   User @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId]) // avoid duplicate pending requests
  @@index([receiverId, status])
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// Materialized friendship for fast "are they friends?" checks
model Friendship {
  id        String   @id @default(uuid())
  userId1   String // enforce userId1 < userId2 at application layer
  userId2   String
  createdAt DateTime @default(now())

  user1 User @relation("FriendshipUser1", fields: [userId1], references: [id], onDelete: Cascade)
  user2 User @relation("FriendshipUser2", fields: [userId2], references: [id], onDelete: Cascade)

  @@unique([userId1, userId2])
  @@index([userId2])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockedBy", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

// ------------------------------------------------------------
// 3 & 4. CONVERSATION (DIRECT + GROUP)
// ------------------------------------------------------------

model Conversation {
  id            String           @id @default(uuid())
  type          ConversationType
  name          String? // group name only
  avatarUrl     String? // group avatar only
  backgroundUrl String? // shared background — applies to direct & group alike
  // DIRECT-only fields: enforce userId1 < userId2 at application layer to prevent duplicate pairs
  userId1       String?
  userId2       String?
  lastMessageAt DateTime?
  // Trỏ tới Message thật (không denormalize nội dung) để preview luôn khớp
  // trạng thái mới nhất của tin đó (vd tự ẩn nội dung nếu tin bị thu hồi sau đó).
  lastMessageId String?          @unique
  createdAt     DateTime         @default(now())

  user1       User?    @relation("DirectUser1", fields: [userId1], references: [id])
  user2       User?    @relation("DirectUser2", fields: [userId2], references: [id])
  lastMessage Message? @relation("ConversationLastMessage", fields: [lastMessageId], references: [id], onDelete: SetNull)

  members       ConversationMember[]
  messages      Message[]
  calls         Call[]
  nicknames     ConversationNickname[]
  inviteLinks   GroupInviteLink[]
  notifications Notification[]

  @@unique([userId1, userId2]) // one row per direct pair
  @@index([lastMessageAt])
}

enum ConversationType {
  DIRECT
  GROUP
}

model ConversationMember {
  id                String     @id @default(uuid())
  conversationId    String
  userId            String
  role              MemberRole @default(MEMBER) // meaningful for GROUP only
  lastReadMessageId String? // read-receipt cursor, avoids a row per message per user
  lastReadAt        DateTime?
  joinedAt          DateTime   @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

enum MemberRole {
  ADMIN
  MEMBER
}

// Nicknames: shared/visible to everyone in the conversation (Messenger-style),
// one nickname per (conversation, target user) — whoever last set it wins.
model ConversationNickname {
  id             String   @id @default(uuid())
  conversationId String
  targetUserId   String // the person being nicknamed
  nickname       String
  setById        String // who set it, for audit/attribution
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  setBy        User         @relation("NicknameSetBy", fields: [setById], references: [id])

  @@unique([conversationId, targetUserId])
}

model GroupInviteLink {
  id             String   @id @default(uuid())
  conversationId String
  token          String   @unique
  createdById    String
  revoked        Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([conversationId])
}

// ------------------------------------------------------------
// 5. MESSAGE
// ------------------------------------------------------------

model Message {
  id             String      @id @default(uuid())
  conversationId String
  senderId       String
  type           MessageType
  content        String?     @db.Text // text content, or sticker code
  mediaUrl       String? // Cloudinary secure_url, for IMAGE/VIDEO/FILE
  mediaPublicId  String? // Cloudinary public_id — required to delete the asset on recall
  mediaName      String? // original filename, for FILE (display only, not trusted for access)
  mediaSize      Int? // bytes, for FILE (display only)
  replyToId      String?
  isRecalled     Boolean     @default(false)
  recalledAt     DateTime?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])
  replyTo      Message?     @relation("MessageReplies", fields: [replyToId], references: [id])
  replies      Message[]    @relation("MessageReplies")

  reactions      MessageReaction[]
  deletions      MessageDeletion[] // "delete for me" records
  // back-relation bắt buộc cho Conversation.lastMessageId — 1 message chỉ có thể
  // là "tin cuối" của đúng 1 conversation (conversationId của nó) nên @unique ở trên là đúng
  lastMessageFor Conversation?     @relation("ConversationLastMessage")

  callId String? @unique
  call   Call?   @relation(fields: [callId], references: [id])

  @@index([conversationId, createdAt]) // cursor-based pagination
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  FILE
  STICKER
  SYSTEM // sự kiện nhóm (thêm/xoá thành viên, đổi tên...), không phải tin nhắn thật
  CALL // lịch sử cuộc gọi, tạo 1 lần khi cuộc gọi kết thúc hẳn
}

model Call {
  id                   String     @id @default(uuid())
  conversationId       String
  // Chỉ có giá trị khi RINGING/ONGOING, set null cùng transaction khi kết thúc —
  // @unique ở tầng DB chặn 2 cuộc gọi đang hoạt động cho cùng 1 conversation
  // (MySQL cho phép nhiều NULL trong unique index nên các cuộc gọi đã kết thúc không xung đột).
  activeConversationId String?    @unique
  startedById          String
  type                 CallType
  status               CallStatus @default(RINGING)
  livekitRoomName      String     @unique
  startedAt            DateTime   @default(now())
  endedAt              DateTime?

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  startedBy    User              @relation(fields: [startedById], references: [id])
  participants CallParticipant[]
  // 1 cuộc gọi sinh đúng 1 tin CALL, tạo khi cuộc gọi kết thúc (cùng pattern lastMessageId)
  message      Message?

  @@index([conversationId])
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ONGOING
  ENDED
  MISSED
  DECLINED
}

model CallParticipant {
  id       String    @id @default(uuid())
  callId   String
  userId   String
  // null = được mời nhưng chưa bắt máy (joinedAt null + leftAt set nghĩa là đã từ chối)
  joinedAt DateTime?
  leftAt   DateTime?

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callId, userId])
}

model MessageReaction {
  id           String   @id @default(uuid())
  messageId    String
  userId       String
  reactionType String // emoji code, e.g. "like", "love", "haha"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId]) // one reaction per user per message; change = update, not insert
}

// "Delete for me" — hides a message only from this user's view
model MessageDeletion {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  deletedAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}
