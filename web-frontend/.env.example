# URL tới backend NestJS. Dùng VITE_ prefix để Vite inline vào bundle client.
VITE_API_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001

# OAuth Client ID loại "Web application" (KHÁC loại Android/iOS mobile đang dùng) —
# tạo trên Google Cloud Console, thêm http://localhost:5173 vào "Authorized JavaScript
# origins". Sau khi có, thêm (phân tách dấu phẩy) vào GOOGLE_CLIENT_IDS của backend.
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Web Push (FCM) — để trống thì banner bật thông báo bị ẩn, app vẫn chạy bình thường.
# firebaseConfig: Firebase Console → Project settings → Your apps → Web app.
# VAPID key: Project settings → Cloud Messaging → Web configuration (public key).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
