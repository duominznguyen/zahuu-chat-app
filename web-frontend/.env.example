# URL tới backend NestJS. Dùng VITE_ prefix để Vite inline vào bundle client.
VITE_API_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001

# OAuth Client ID loại "Web application" (KHÁC loại Android/iOS mobile đang dùng) —
# tạo trên Google Cloud Console, thêm http://localhost:5173 vào "Authorized JavaScript
# origins". Sau khi có, thêm (phân tách dấu phẩy) vào GOOGLE_CLIENT_IDS của backend.
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
